{
  "name": "supermarket-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node ../backend/node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "test:live": "node ../backend/node_modules/tsx/dist/cli.mjs --test tests/live.integration.ts",
    "test:private-live": "node ../backend/node_modules/tsx/dist/cli.mjs --test tests/private.integration.ts",
    "test:browser": "node tests/browser.smoke.cjs",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
