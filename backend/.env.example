HOST=0.0.0.0
PORT=3000
# Exact browser origins, comma-separated. Native Expo requests need no Origin.
CORS_ORIGINS=http://localhost:8081
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=supermarket_comparison
DB_USER=supermarket_app
DB_PASSWORD=
PRICE_FRESHNESS_DAYS=30
# Public demo provider: max 1 request/second, no heavy use; attribution required.
# Adapter enforces serial requests, caching and deadlines. Loopback HTTP is
# allowed for a future self-hosted instance. Never put credentials in this URL.
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
